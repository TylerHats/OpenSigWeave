# OpenSigWeave Environment Variables
# COPY THIS FILE AND RENAME IT TO .env

SECRET_KEY="your_secure_random_string_here"
AUTHENTIK_URL="https://auth.yourdomain.com"
AUTHENTIK_SLUG="opensigweave"
CLIENT_ID="your_authentik_client_id"
CLIENT_SECRET="your_authentik_client_secret"
AUTHENTIK_API_TOKEN="your_authentik_service_account_token"
